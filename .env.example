# Provider: anthropic (default), openai, or xai
# SILICON_PROVIDER=anthropic

# API key for the selected provider (required)
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# XAI_API_KEY=xai-...

# Optional overrides
# Model defaults: claude-sonnet-5 (anthropic), gpt-5.6-luna (openai), grok-build-0.1 (xai)
# SILICON_MODEL=claude-sonnet-5
# Multi-word values must be quoted (dotenvy rejects unquoted spaces).
# SILICON_MODEL_INTRO="You are Si, a coding agent."
# SILICON_EFFORT=medium
